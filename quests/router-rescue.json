      "answer": 1,
      "xp": 120
    },
    {
      "kind": "text",
      "prompt": "Type the address most home routers answer on.",
      "match": "^(https?://)?192\\.168\\.(0|1)\\.1/?$",
      "hint": "192.168.1.1",
      "xp": 180
    }
  ]
}
